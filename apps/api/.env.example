# Copy to .env (apps/api/.env)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/video_meetings?schema=public
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Storage directory for meeting files (absolute, or relative to apps/api); never served statically
FILES_DIR=./storage
# Signs short-lived file download links; separate from JWT_SECRET (`npm run gen:secret`)
FILE_LINK_SECRET=change-me
# Hourly removal of abandoned uploads and orphan files; `off` disables it (the e2e config does)
# FILES_CLEANUP=off

# Background processing (pg-boss on the same database, own schema)
# PGBOSS_SCHEMA=pgboss
# JOBS_POLLING_INTERVAL_SECONDS=2
# Longest extraction + summary of one document before FAILED; a recording's analysis gets this
# for every started hour of the recording
# DOCUMENT_PROCESSING_TIMEOUT_SECONDS=900

# Recordings: longer ones end in FAILED instead of being transcribed (minutes)
MAX_RECORDING_MINUTES=180
# ffmpeg / ffprobe binaries; default to the ones installed by ffmpeg-static / @ffprobe-installer
# FFMPEG_PATH=
# FFPROBE_PATH=

# Document summaries, transcripts and the analysis of a recording (summary, action items,
# decisions): `local` uses whisper.cpp and the Ollama model below, `fake` deterministic
# stand-ins (tests, dev; no Ollama needed)
AI_PROVIDER=fake
# whisper.cpp CLI (a release build, or `whisper-cli` on PATH) and its ggml model, needed with
# AI_PROVIDER=local: WHISPER_MODELS_DIR/ggml-<WHISPER_MODEL>.bin (models/ is git-ignored)
WHISPER_CLI_PATH=whisper-cli
WHISPER_MODELS_DIR=./models
WHISPER_MODEL=base.en
WHISPER_THREADS=4
# Transcription timeout = duration x WHISPER_SPEED_FACTOR + TRANSCRIPTION_TIMEOUT_MARGIN_SECONDS
# (measured on a 4-core laptop CPU: base.en takes about 0.25 x the duration, small.en about 0.7 x)
# WHISPER_SPEED_FACTOR=1.5
# TRANSCRIPTION_TIMEOUT_MARGIN_SECONDS=300
OLLAMA_URL=http://localhost:11434
# Required with AI_PROVIDER=local (the app refuses to start without it), e.g. qwen3:4b or
# gemma3:4b (`ollama pull <model>` first); summarizes documents and analyzes recordings
OLLAMA_MODEL=
OLLAMA_NUM_CTX=16384
