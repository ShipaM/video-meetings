# Copy to .env (apps/api/.env)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/video_meetings?schema=public
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Storage directory for meeting files (absolute, or relative to apps/api); never served statically
FILES_DIR=./storage
# Signs short-lived file download links; separate from JWT_SECRET (`npm run gen:secret`)
FILE_LINK_SECRET=change-me
