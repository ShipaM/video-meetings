generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  meetings     Meeting[]
  meetingFiles MeetingFile[]
}

model Meeting {
  id        String        @id @default(uuid())
  title     String
  startsAt  DateTime
  ownerId   String
  owner     User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  files     MeetingFile[]

  @@index([ownerId])
}

enum MeetingFileStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
}

enum MeetingFileKind {
  AUDIO
  VIDEO
  DOCUMENT
  IMAGE
}

model MeetingFile {
  // Equals the tus upload id, generated by the server.
  id                String            @id
  meetingId         String
  meeting           Meeting           @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  uploadedById      String
  uploadedBy        User              @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  originalName      String
  mimeType          String
  kind              MeetingFileKind
  // 2 GiB does not fit into a PostgreSQL integer.
  size              BigInt
  status            MeetingFileStatus @default(UPLOADING)
  failureReason     String?
  // Name of the data file inside FILES_DIR/uploads; never derived from user input.
  storageKey        String            @unique
  processingAttempt Int               @default(0)
  lastChunkAt       DateTime          @default(now())
  createdAt         DateTime          @default(now())
  completedAt       DateTime?
  updatedAt         DateTime          @updatedAt

  @@index([meetingId, status])
  @@index([status, lastChunkAt])
}
