generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String               @id @default(uuid())
  email        String               @unique
  passwordHash String
  // Display name; null when the user has not set one.
  name         String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  meetings     Meeting[]
  meetingFiles MeetingFile[]
  sharedWith   MeetingParticipant[]
  avatars      UserAvatar[]
}

enum UserAvatarStatus {
  UPLOADING
  READY
}

// An avatar image uploaded through tus; the data file lives in FILES_DIR/uploads like meeting files.
model UserAvatar {
  // Equals the tus upload id and the storage key, generated by the server.
  id          String           @id
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  mimeType    String
  size        Int
  status      UserAvatarStatus @default(UPLOADING)
  lastChunkAt DateTime         @default(now())
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([userId])
  @@index([status, lastChunkAt])
}

model Meeting {
  id           String               @id @default(uuid())
  title        String
  startsAt     DateTime
  ownerId      String
  owner        User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  files        MeetingFile[]
  participants MeetingParticipant[]

  @@index([ownerId])
}

// A registered user the owner shared the meeting with (read-only access).
model MeetingParticipant {
  meetingId String
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  addedAt   DateTime @default(now())

  @@id([meetingId, userId])
  @@index([userId])
}

enum MeetingFileStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
}

enum MeetingFileKind {
  AUDIO
  VIDEO
  DOCUMENT
  IMAGE
}

model MeetingFile {
  // Equals the tus upload id, generated by the server.
  id                String              @id
  meetingId         String
  meeting           Meeting             @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  uploadedById      String
  uploadedBy        User                @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  originalName      String
  mimeType          String
  kind              MeetingFileKind
  // 2 GiB does not fit into a PostgreSQL integer.
  size              BigInt
  status            MeetingFileStatus   @default(UPLOADING)
  failureReason     String?
  // Name of the data file inside FILES_DIR/uploads; never derived from user input.
  storageKey        String              @unique
  processingAttempt Int                 @default(0)
  lastChunkAt       DateTime            @default(now())
  createdAt         DateTime            @default(now())
  completedAt       DateTime?
  updatedAt         DateTime            @updatedAt
  // Length of a recording, known once its processing has probed it.
  durationMs        Int?
  summary           MeetingFileSummary?
  transcript        TranscriptSegment[]

  @@index([meetingId, status])
  @@index([status, lastChunkAt])
}

// The summary a processing job produced for a file; goes with the file.
model MeetingFileSummary {
  fileId    String      @id
  file      MeetingFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime    @default(now())
}

// One timed piece of a recording's transcript; `position` orders the pieces of a file.
model TranscriptSegment {
  fileId   String
  file     MeetingFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  position Int
  startMs  Int
  endMs    Int
  text     String

  @@id([fileId, position])
}
